# Server
PORT=3000
BASE_URL=http://localhost:3000

# Twitch OAuth2 Application (https://dev.twitch.tv/console/apps)
# Add Redirect URL in Twitch Console: http://localhost:3000/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# Optional: Kacky polling interval in ms (default 15000 = 15s)
KACKY_POLL_INTERVAL_MS=15000

# Optional: Comma-separated map numbers auto-armed on fresh login (great for Render Free resets)
DEFAULT_ARMED_MAPS=

# Optional: SQLite DB path
DB_PATH=./data/kackyalarm.sqlite
